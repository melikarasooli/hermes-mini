  },
  "ai": { "binding": "AI" },
  // بعداً وقتی zone فعال شد: routes روی tg.amirabroun.ir + workers_dev:false
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hermes-mini",
      "database_id": "a2b0da68-8ac2-4e9e-97df-011f01f6a356"
    }
  ],
  "observability": { "enabled": true }
}
